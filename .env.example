# Datalab OCR API configuration
DATALAB_API_KEY=your_datalab_api_key_here
DATALAB_API_URL=https://api.datalab.to/v1/marker

# LLM / Vision Provider configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
SOLVER_MODEL=gpt-4o
VISION_MODEL=gpt-4o

# Agent Refinement Loop Settings
MAX_RETRIES=3
OCR_MOCK_FALLBACK=true
TEMPERATURE=0.1
