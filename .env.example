# Datalab OCR API configuration
DATALAB_API_KEY=your_datalab_api_key_here
DATALAB_API_URL=https://api.datalab.to/v1/marker

# OpenRouter LLM / Vision Provider configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet

# Agent Refinement Loop Settings
MAX_RETRIES=3
OCR_MOCK_FALLBACK=true
TEMPERATURE=0.1
